#Explination:
#This is saying that when you inpt your name and language, if your language is in the list it prints the defined greet, language, and the greeting in that language.
name = input('What is your name? ')
lang = input('What is your language? Pick from: es, fr, en, it: ')

if lang in ['es', 'fr', 'en', 'it']:
    def greet(lang):
        if lang == 'es':
            return 'Hola'
        elif lang == 'fr':
            return 'Bonjour'
        elif lang == 'it':
            return 'Salve'
        else:
            return 'Hello'

    def main():
        print(greet(lang), name)
    
    main()

else:
    print("Your language isn't supported. Yet.")
